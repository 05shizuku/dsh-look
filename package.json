{
  "name": "dsh-look",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "视觉 consent：默认不看，主动看必留痕，可拒绝。",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./look": "./src/index.mjs",
